---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist."
  path="/404"
>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="font-mono text-sm uppercase tracking-wide text-[var(--text-secondary)]">404</p>
    <h1 class="mt-3 font-display text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl">
      Page not found
    </h1>
    <p class="mt-3 text-base text-[var(--text-secondary)]">
      The page you're looking for doesn't exist or may have moved. Try searching for a tool instead.
    </p>

    <div class="mt-8 w-full">
      <SearchBar size="large" placeholder="Search for a tool..." />
    </div>

    <a
      href="/"
      class="mt-8 rounded-[var(--radius-sm)] border border-[var(--border-color)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--surface-raised)]"
    >
      Back to home
    </a>
  </div>
</BaseLayout>

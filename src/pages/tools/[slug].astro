---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ComingSoon from "../../components/tools/ComingSoon.astro";
import TextReplacer from "../../components/tools/TextReplacer.astro";
import JsonFormatter from "../../components/tools/JsonFormatter.astro";
import HtmlViewer from "../../components/tools/HtmlViewer.astro";
import WordCounter from "../../components/tools/WordCounter.astro";
import CaseConverter from "../../components/tools/CaseConverter.astro";
import UuidGenerator from "../../components/tools/UuidGenerator.astro";
import { tools, getToolBySlug } from "../../data/tools";

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params;
const tool = getToolBySlug(slug!);

if (!tool) {
  return Astro.redirect("/404");
}

// Map slugs to their implemented interactive component.
type AstroComponent = typeof TextReplacer;
const liveComponents: Record<string, AstroComponent> = {
  "text-replacer": TextReplacer,
  "json-formatter": JsonFormatter,
  "html-viewer": HtmlViewer,
  "word-counter": WordCounter,
  "case-converter": CaseConverter,
  "uuid-generator": UuidGenerator,
};

const LiveComponent = liveComponents[tool.slug];
---

<ToolLayout tool={tool}>
  {LiveComponent ? <LiveComponent /> : <ComingSoon />}
</ToolLayout>

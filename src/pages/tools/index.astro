---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolCard from "../../components/ToolCard.astro";
import { tools } from "../../data/tools";
import { categories } from "../../data/categories";
---

<BaseLayout
  title="All Tools"
  description="Browse the full collection of 52 Tools utilities — formatters, converters, generators, and more."
  path="/tools"
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: "Tools" }]} />

    <div class="mb-8">
      <h1 class="font-display text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl">All Tools</h1>
      <p class="mt-2 max-w-2xl text-base text-[var(--text-secondary)]">
        {tools.length} tools across {categories.length} categories.
      </p>
    </div>

    <div class="mb-6 flex flex-wrap gap-2" role="tablist" aria-label="Filter by category">
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="rounded-full border border-[var(--text-primary)] bg-[var(--text-primary)] px-3 py-1.5 text-xs font-medium text-[var(--surface)]"
      >
        All
      </button>
      {
        categories.map((category) => (
          <button
            type="button"
            data-filter={category.slug}
            aria-pressed="false"
            class="rounded-full border border-[var(--border-color)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:border-[var(--text-primary)] hover:text-[var(--text-primary)]"
          >
            {category.name}
          </button>
        ))
      }
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <div data-tool-item data-category={tool.category}>
            <ToolCard tool={tool} />
          </div>
        ))
      }
    </div>

    <p
      data-empty
      class="mt-6 hidden rounded-[var(--radius-md)] border border-dashed border-[var(--border-color)] p-10 text-center text-sm text-[var(--text-secondary)]"
    >
      No tools in this category yet.
    </p>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-tool-item]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");

  function applyFilter(filter: string) {
    let visibleCount = 0;
    items.forEach((item) => {
      const match = filter === "all" || item.dataset.category === filter;
      item.classList.toggle("hidden", !match);
      if (match) visibleCount++;
    });
    empty?.classList.toggle("hidden", visibleCount > 0);

    buttons.forEach((btn) => {
      const active = btn.dataset.filter === filter;
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.toggle("border-[var(--text-primary)]", active);
      btn.classList.toggle("bg-[var(--text-primary)]", active);
      btn.classList.toggle("text-[var(--surface)]", active);
      btn.classList.toggle("border-[var(--border-color)]", !active);
      btn.classList.toggle("text-[var(--text-secondary)]", !active);
    });
  }

  buttons.forEach((btn) => btn.addEventListener("click", () => applyFilter(btn.dataset.filter!)));
</script>

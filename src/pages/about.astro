---
import BaseLayout from "../layouts/BaseLayout.astro";
import { tools } from "../data/tools";
import { categories } from "../data/categories";

const liveCount = tools.filter((t) => t.status === "live").length;
---

<BaseLayout
  title="About"
  description="52 Tools is a precise, fast collection of practical web utilities for creators, developers, and problem solvers."
  path="/about"
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="font-display text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl">About 52 Tools</h1>

    <p class="mt-6 text-base leading-relaxed text-[var(--text-secondary)]">
      52 Tools is a growing collection of practical, no-nonsense web utilities — formatters, converters,
      generators, and calculators — built for the moments when you just need something to work, quickly,
      without an account or a cluttered interface.
    </p>

    <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">
      The name is a starting point, not a limit. New tools are added regularly across {categories.length}{" "}
      categories, and {liveCount} are fully functional today.
    </p>

    <h2 class="mt-10 font-display text-xl font-semibold text-[var(--text-primary)]">Principles</h2>
    <ul class="mt-4 space-y-3 text-base leading-relaxed text-[var(--text-secondary)]">
      <li><strong class="text-[var(--text-primary)]">Precision</strong> — every element is deliberate and exact.</li>
      <li><strong class="text-[var(--text-primary)]">Utility</strong> — design exists to serve a clear purpose.</li>
      <li><strong class="text-[var(--text-primary)]">Speed</strong> — the experience feels efficient and focused.</li>
      <li><strong class="text-[var(--text-primary)]">Simplicity</strong> — unnecessary visual noise is removed.</li>
    </ul>

    <a
      href="/tools"
      class="mt-10 inline-block rounded-[var(--radius-sm)] bg-[var(--text-primary)] px-5 py-2.5 text-sm font-medium text-[var(--surface)] hover:opacity-90"
    >
      Browse all tools
    </a>
  </div>
</BaseLayout>

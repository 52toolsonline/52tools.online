---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import { categories } from "../../data/categories";
---

<BaseLayout
  title="Categories"
  description="Browse 52 Tools by category — text, developer, image, PDF, date & time, numbers, security, and web utilities."
  path="/categories"
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: "Categories" }]} />

    <div class="mb-8">
      <h1 class="font-display text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl">Categories</h1>
      <p class="mt-2 max-w-2xl text-base text-[var(--text-secondary)]">
        Every tool, organized by what it's for.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((category) => <CategoryCard category={category} />)}
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolGrid from "../../components/ToolGrid.astro";
import { categories, getCategoryBySlug } from "../../data/categories";
import { getToolsByCategory } from "../../data/tools";

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug } }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug!);

if (!category) {
  return Astro.redirect("/404");
}

const categoryTools = getToolsByCategory(category.slug);
const relatedCategories = categories.filter((c) => c.slug !== category.slug).slice(0, 3);
---

<BaseLayout
  title={category.name}
  description={category.description}
  path={`/categories/${category.slug}`}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: "Categories", href: "/categories" }, { label: category.name }]} />

    <div class="mb-8">
      <h1 class="font-display text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl">{category.name}</h1>
      <p class="mt-2 max-w-2xl text-base text-[var(--text-secondary)]">{category.description}</p>
      <p class="mt-2 font-mono text-xs uppercase tracking-wide text-[var(--text-secondary)]">
        {categoryTools.length} {categoryTools.length === 1 ? "tool" : "tools"}
      </p>
    </div>

    <ToolGrid tools={categoryTools} emptyMessage="No tools in this category yet." />

    {
      relatedCategories.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-4 font-display text-xl font-semibold text-[var(--text-primary)]">Other categories</h2>
          <div class="flex flex-wrap gap-2">
            {relatedCategories.map((c) => (
              <a
                href={`/categories/${c.slug}`}
                class="rounded-full border border-[var(--border-color)] px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] hover:border-[var(--text-primary)] hover:text-[var(--text-primary)]"
              >
                {c.name}
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

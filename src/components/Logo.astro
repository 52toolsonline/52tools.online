---
interface Props {
  /** "monogram" for icon-only, "lockup" for monogram + wordmark */
  variant?: "monogram" | "lockup";
  /** pixel width; height derives from image aspect ratio */
  width?: number;
  class?: string;
  href?: string;
}

const { variant = "lockup", width = 40, class: className = "", href = "/" } = Astro.props;

const src = variant === "monogram" ? "/brand/favicon-logo.png" : "/brand/logo-transparent.png";
const alt = variant === "monogram" ? "52 Tools" : "52 Tools logo";
---

<a
  href={href}
  class={`inline-flex items-center gap-2 shrink-0 dark:invert ${className}`}
  aria-label="52 Tools — home"
>
  <img src={src} alt={alt} width={width} style={{ height: "auto" }} decoding="async" />
</a>

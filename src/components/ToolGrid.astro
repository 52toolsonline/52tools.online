---
import ToolCard from "./ToolCard.astro";
import type { Tool } from "../data/tools";

interface Props {
  tools: Tool[];
  emptyMessage?: string;
}

const { tools, emptyMessage = "No tools found." } = Astro.props;
---

{
  tools.length > 0 ? (
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  ) : (
    <div class="rounded-[var(--radius-md)] border border-dashed border-[var(--border-color)] p-10 text-center">
      <p class="text-sm text-[var(--text-secondary)]">{emptyMessage}</p>
    </div>
  )
}

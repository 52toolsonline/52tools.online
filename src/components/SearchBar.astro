---
import { Search, X } from "@lucide/astro";
import { tools } from "../data/tools";
import { categories } from "../data/categories";
import { getPopularSearches } from "../lib/search";

interface Props {
  /** "compact" for header, "large" for homepage hero */
  size?: "compact" | "large";
  placeholder?: string;
}

const { size = "compact", placeholder = "Search tools..." } = Astro.props;

const popular = getPopularSearches().map((t) => ({ slug: t.slug, name: t.name, category: t.category }));
const toolsData = tools.map((t) => ({
  slug: t.slug,
  name: t.name,
  category: t.category,
  description: t.description,
  keywords: t.keywords,
  status: t.status,
}));
const categoriesData = categories.map((c) => ({ slug: c.slug, name: c.name, description: c.description }));

const isLarge = size === "large";
---

<div class="relative w-full" data-search-root>
  <div
    class={`group relative flex items-center rounded-[var(--radius-md)] border border-[var(--border-color)] bg-[var(--surface-raised)] transition-[border-color,box-shadow] focus-within:border-[var(--text-primary)] focus-within:shadow-[0_0_0_3px_rgba(11,11,12,0.06)] dark:focus-within:shadow-[0_0_0_3px_rgba(250,250,250,0.06)] ${
      isLarge ? "h-14 px-5" : "h-10 px-3"
    }`}
  >
    <Search class={isLarge ? "h-5 w-5 text-[var(--text-secondary)]" : "h-4 w-4 text-[var(--text-secondary)]"} aria-hidden="true" />
    <input
      type="text"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-dropdown"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      data-global-search-input
      aria-label="Search tools"
      placeholder={placeholder}
      class={`w-full bg-transparent font-body text-[var(--text-primary)] placeholder:text-[var(--text-secondary)] outline-none ${
        isLarge ? "ml-3 text-base" : "ml-2 text-sm"
      }`}
    />
    <button
      type="button"
      data-search-clear
      aria-label="Clear search"
      class="hidden shrink-0 rounded-full p-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
    >
      <X class="h-4 w-4" aria-hidden="true" />
    </button>
    <kbd
      data-search-kbd
      class="ml-2 hidden shrink-0 items-center gap-0.5 rounded-[var(--radius-sm)] border border-[var(--border-color)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-secondary)] sm:flex"
    >
      <span data-kbd-mod>Ctrl</span>K
    </kbd>
  </div>

  <div
    id="search-dropdown"
    data-search-dropdown
    role="listbox"
    style="overscroll-behavior: contain;"
    class="invisible absolute left-0 right-0 top-[calc(100%+8px)] z-40 max-h-[70vh] overflow-y-auto rounded-[var(--radius-md)] border border-[var(--border-color)] bg-[var(--surface-raised)] opacity-0 shadow-lg transition-[opacity,visibility] duration-100"
  >
    <div data-search-content class="p-2"></div>
  </div>
</div>

<script is:inline define:vars={{ toolsData, categoriesData, popular }}>
  const TOOLS = toolsData;
  const CATEGORIES = categoriesData;
  const POPULAR = popular;

  function scoreTool(tool, q) {
    const name = tool.name.toLowerCase();
    const category = tool.category.toLowerCase();
    const description = tool.description.toLowerCase();

    if (name === q) return 100;
    if (name.startsWith(q)) return 90;
    if (name.includes(q)) return 75;

    for (const kw of tool.keywords) {
      const k = kw.toLowerCase();
      if (k === q) return 70;
      if (k.startsWith(q) || k.includes(q)) return 60;
    }

    if (category === q || category.includes(q)) return 45;
    if (description.includes(q)) return 30;

    return 0;
  }

  function searchTools(query, limit) {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    return TOOLS.map((tool) => ({ tool, score: scoreTool(tool, q) }))
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score || a.tool.name.localeCompare(b.tool.name))
      .slice(0, limit)
      .map((r) => r.tool);
  }

  function searchCategories(query, limit) {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    return CATEGORIES.filter(
      (c) => c.name.toLowerCase().includes(q) || c.description.toLowerCase().includes(q)
    ).slice(0, limit);
  }

  function escapeHtml(str) {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function toolRow(tool, index) {
    const badge =
      tool.status === "soon"
        ? '<span class="ml-2 rounded-full border border-[var(--border-color)] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-[var(--text-secondary)]">Soon</span>'
        : "";
    return `
      <a
        href="/tools/${tool.slug}"
        role="option"
        data-search-item
        data-index="${index}"
        class="flex items-center justify-between gap-3 rounded-[var(--radius-sm)] px-3 py-2.5 text-sm text-[var(--text-primary)] hover:bg-[var(--surface)] data-[active=true]:bg-[var(--surface)]"
      >
        <span class="flex min-w-0 flex-col">
          <span class="flex items-center truncate font-medium">${escapeHtml(tool.name)}${badge}</span>
          <span class="truncate text-xs text-[var(--text-secondary)]">${escapeHtml(tool.description)}</span>
        </span>
        <span class="shrink-0 font-mono text-[10px] uppercase tracking-wide text-[var(--text-secondary)]">${escapeHtml(
          tool.category
        )}</span>
      </a>`;
  }

  function categoryRow(cat, index) {
    return `
      <a
        href="/categories/${cat.slug}"
        role="option"
        data-search-item
        data-index="${index}"
        class="flex items-center justify-between gap-3 rounded-[var(--radius-sm)] px-3 py-2.5 text-sm text-[var(--text-primary)] hover:bg-[var(--surface)] data-[active=true]:bg-[var(--surface)]"
      >
        <span class="font-medium">${escapeHtml(cat.name)}</span>
        <span class="text-xs text-[var(--text-secondary)]">Category</span>
      </a>`;
  }

  function sectionLabel(label) {
    return `<div class="px-3 pb-1 pt-3 font-mono text-[10px] uppercase tracking-wide text-[var(--text-secondary)] first:pt-1">${label}</div>`;
  }

  function initSearch(root) {
    const input = root.querySelector("[data-global-search-input]");
    const dropdown = root.querySelector("[data-search-dropdown]");
    const content = root.querySelector("[data-search-content]");
    const clearBtn = root.querySelector("[data-search-clear]");
    if (!input || !dropdown || !content || !clearBtn) return;

    let activeIndex = -1;
    let currentItemCount = 0;

    function openDropdown() {
      dropdown.classList.remove("invisible", "opacity-0");
      input.setAttribute("aria-expanded", "true");
    }

    function closeDropdown() {
      dropdown.classList.add("invisible", "opacity-0");
      input.setAttribute("aria-expanded", "false");
      activeIndex = -1;
    }

    function renderEmptyPopular() {
      let html = sectionLabel("Popular searches");
      html += POPULAR.map((tool, i) => toolRow(tool, i)).join("");
      content.innerHTML = html;
      currentItemCount = POPULAR.length;
    }

    function renderResults(query) {
      const matchedTools = searchTools(query, 8);
      const matchedCategories = searchCategories(query, 3);

      if (matchedTools.length === 0 && matchedCategories.length === 0) {
        content.innerHTML = `
          <div class="px-3 py-6 text-center">
            <p class="text-sm text-[var(--text-primary)]">No tools found for "${escapeHtml(query)}".</p>
            <p class="mt-1 text-xs text-[var(--text-secondary)]">Try a different term or browse categories.</p>
            <a href="/categories" class="mt-3 inline-block rounded-[var(--radius-sm)] border border-[var(--border-color)] px-3 py-1.5 text-xs font-medium hover:bg-[var(--surface)]">Browse categories</a>
          </div>`;
        currentItemCount = 0;
        return;
      }

      let html = "";
      let index = 0;
      if (matchedTools.length > 0) {
        html += sectionLabel(`Tools (${matchedTools.length})`);
        for (const tool of matchedTools) {
          html += toolRow(tool, index);
          index++;
        }
      }
      if (matchedCategories.length > 0) {
        html += sectionLabel("Categories");
        for (const cat of matchedCategories) {
          html += categoryRow(cat, index);
          index++;
        }
      }
      content.innerHTML = html;
      currentItemCount = index;
    }

    function updateActive() {
      const items = content.querySelectorAll("[data-search-item]");
      items.forEach((el, i) => {
        if (i === activeIndex) {
          el.setAttribute("data-active", "true");
          el.scrollIntoView({ block: "nearest" });
        } else {
          el.removeAttribute("data-active");
        }
      });
    }

    input.addEventListener("focus", () => {
      const q = input.value.trim();
      if (q) {
        renderResults(q);
      } else {
        renderEmptyPopular();
      }
      openDropdown();
    });

    input.addEventListener("input", () => {
      const q = input.value.trim();
      clearBtn.classList.toggle("hidden", q.length === 0);
      activeIndex = -1;
      if (q) {
        renderResults(q);
      } else {
        renderEmptyPopular();
      }
      openDropdown();
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (currentItemCount === 0) return;
        activeIndex = (activeIndex + 1) % currentItemCount;
        updateActive();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (currentItemCount === 0) return;
        activeIndex = (activeIndex - 1 + currentItemCount) % currentItemCount;
        updateActive();
      } else if (e.key === "Enter") {
        if (activeIndex >= 0) {
          const items = content.querySelectorAll("[data-search-item]");
          const el = items[activeIndex];
          if (el instanceof HTMLAnchorElement) {
            e.preventDefault();
            window.location.href = el.href;
          }
        }
      } else if (e.key === "Escape") {
        closeDropdown();
        input.blur();
      }
    });

    clearBtn.addEventListener("click", () => {
      input.value = "";
      clearBtn.classList.add("hidden");
      renderEmptyPopular();
      input.focus();
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target)) {
        closeDropdown();
      }
    });
  }

  // Initialize every search bar instance on the page.
  document.querySelectorAll("[data-search-root]").forEach((root) => initSearch(root));

  // Global keyboard shortcut: Cmd/Ctrl + K focuses the first visible search input.
  if (!window.__searchShortcutBound) {
    window.__searchShortcutBound = true;
    document.addEventListener("keydown", (e) => {
      const isShortcut = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k";
      if (!isShortcut) return;
      e.preventDefault();
      const inputs = Array.from(document.querySelectorAll("[data-global-search-input]"));
      const visible = inputs.find((el) => el.offsetParent !== null);
      visible?.focus();
    });
  }

  // Show the correct shortcut key label for the platform.
  const isMac = /Mac|iPhone|iPod|iPad/.test(navigator.platform || navigator.userAgent);
  document.querySelectorAll("[data-kbd-mod]").forEach((el) => {
    el.textContent = isMac ? "⌘" : "Ctrl";
  });
</script>

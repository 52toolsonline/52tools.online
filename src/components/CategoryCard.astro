---
import * as icons from "@lucide/astro";
import { ArrowUpRight } from "@lucide/astro";
import type { Category } from "../data/categories";
import { getToolsByCategory } from "../data/tools";

interface Props {
  category: Category;
}

const { category } = Astro.props;
const IconComponent = (icons as Record<string, any>)[category.icon] ?? icons.Wrench;
const toolCount = getToolsByCategory(category.slug).length;
---

<a
  href={`/categories/${category.slug}`}
  class="group flex flex-col rounded-[var(--radius-md)] border border-[var(--border-color)] bg-[var(--surface-raised)] p-6 transition-colors hover:border-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-[var(--text-primary)]"
>
  <div class="flex items-start justify-between">
    <span
      class="flex h-10 w-10 items-center justify-center rounded-[var(--radius-sm)] border border-[var(--border-color)] text-[var(--text-primary)]"
    >
      <IconComponent class="h-5 w-5" aria-hidden="true" />
    </span>
    <ArrowUpRight
      class="h-4 w-4 text-[var(--text-secondary)] opacity-0 transition-opacity group-hover:opacity-100"
      aria-hidden="true"
    />
  </div>
  <h3 class="mt-4 font-display text-base font-semibold text-[var(--text-primary)]">{category.name}</h3>
  <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-secondary)]">{category.description}</p>
  <p class="mt-4 font-mono text-xs uppercase tracking-wide text-[var(--text-secondary)]">
    {toolCount} {toolCount === 1 ? "tool" : "tools"}
  </p>
</a>

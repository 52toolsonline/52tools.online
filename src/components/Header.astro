---
import { Menu, X } from "@lucide/astro";
import Logo from "./Logo.astro";
import SearchBar from "./SearchBar.astro";
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
  { href: "/categories", label: "Categories" },
  { href: "/tools", label: "Tools" },
  { href: "/about", label: "About" },
];
---

<header
  class="sticky top-0 z-30 border-b border-[var(--border-color)] bg-[var(--surface)]/90 backdrop-blur supports-[backdrop-filter]:bg-[var(--surface)]/80"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <Logo variant="monogram" width={32} />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-[var(--radius-sm)] px-3 py-2 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:bg-[var(--surface-raised)] hover:text-[var(--text-primary)]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto hidden max-w-sm flex-1 md:block">
      <SearchBar size="compact" />
    </div>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <ThemeToggle />
      <button
        type="button"
        data-mobile-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-9 w-9 items-center justify-center rounded-[var(--radius-sm)] border border-[var(--border-color)] text-[var(--text-primary)] md:hidden"
      >
        <Menu class="h-4 w-4" data-icon-open aria-hidden="true" />
        <X class="hidden h-4 w-4" data-icon-close aria-hidden="true" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-mobile-menu
    class="hidden border-t border-[var(--border-color)] bg-[var(--surface)] px-4 py-4 md:hidden"
  >
    <div class="mb-4">
      <SearchBar size="compact" placeholder="Search tools..." />
    </div>
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-[var(--radius-sm)] px-3 py-3 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--surface-raised)]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-mobile-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  const iconOpen = toggle?.querySelector("[data-icon-open]");
  const iconClose = toggle?.querySelector("[data-icon-close]");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
  });
</script>

<section class="t52-hero">
  <div class="t52-container">
    <div class="t52-hero-inner">

      <h1 class="t52-hero-title"><span class="t52-hero-num">52</span> Tools. One Place.</h1>
      <p class="t52-hero-sub">Free, fast, and easy-to-use online tools for your everyday tasks.</p>

      <div class="t52-search-wrap">

---
import { Hammer } from "@lucide/astro";
---

<div class="flex flex-col items-center rounded-[var(--radius-md)] border border-dashed border-[var(--border-color)] px-6 py-16 text-center">
  <span class="flex h-12 w-12 items-center justify-center rounded-full border border-[var(--border-color)] text-[var(--text-secondary)]">
    <Hammer class="h-5 w-5" aria-hidden="true" />
  </span>
  <h2 class="mt-4 font-display text-lg font-semibold text-[var(--text-primary)]">This tool is coming soon</h2>
  <p class="mt-2 max-w-sm text-sm text-[var(--text-secondary)]">
    We're still building this one. Check back shortly, or browse the tools that are ready to use today.
  </p>
  <a
    href="/tools"
    class="mt-6 rounded-[var(--radius-sm)] border border-[var(--border-color)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--surface-raised)]"
  >
    Browse available tools
  </a>
</div>

---
import { Trash2 } from "@lucide/astro";

const stats = [
  { key: "words", label: "Words" },
  { key: "characters", label: "Characters" },
  { key: "charactersNoSpaces", label: "Characters (no spaces)" },
  { key: "lines", label: "Lines" },
  { key: "sentences", label: "Sentences" },
  { key: "paragraphs", label: "Paragraphs" },
];
---

<div class="rounded-[var(--radius-md)] border border-[var(--border-color)] bg-[var(--surface-raised)] p-5 sm:p-6" data-tool="word-counter">
  <label for="wc-input" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[var(--text-secondary)]">Text</label>
  <textarea
    id="wc-input"
    data-input
    rows="10"
    placeholder="Paste or type your text here..."
    class="w-full resize-y rounded-[var(--radius-sm)] border border-[var(--border-color)] bg-[var(--surface)] p-3 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--text-primary)]"
  ></textarea>

  <div class="mt-4">
    <button type="button" data-clear class="inline-flex items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--border-color)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--surface)]">
      <Trash2 class="h-4 w-4" aria-hidden="true" />
      Clear
    </button>
  </div>

  <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
    {
      stats.map((stat) => (
        <div class="rounded-[var(--radius-sm)] border border-[var(--border-color)] bg-[var(--surface)] p-3">
          <dt class="font-mono text-[10px] uppercase tracking-wide text-[var(--text-secondary)]">{stat.label}</dt>
          <dd data-stat={stat.key} class="mt-1 font-display text-2xl font-semibold text-[var(--text-primary)]">
            0
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<script>
  function initWordCounter(root: HTMLElement) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]")!;
    const clearBtn = root.querySelector<HTMLButtonElement>("[data-clear]")!;

    function count(text: string) {
      const words = text.trim() ? (text.trim().match(/\S+/g) ?? []).length : 0;
      const characters = text.length;
      const charactersNoSpaces = text.replace(/\s/g, "").length;
      const lines = text ? text.split(/\n/).length : 0;
      const sentences = text.trim() ? (text.match(/[^.!?]+[.!?]+/g) ?? [text.trim()]).length : 0;
      const paragraphs = text.trim() ? text.split(/\n\s*\n/).filter((p) => p.trim()).length : 0;

      return { words, characters, charactersNoSpaces, lines, sentences, paragraphs };
    }

    function update() {
      const stats = count(input.value);
      for (const [key, value] of Object.entries(stats)) {
        const el = root.querySelector(`[data-stat="${key}"]`);
        if (el) el.textContent = value.toLocaleString();
      }
    }

    input.addEventListener("input", update);
    clearBtn.addEventListener("click", () => {
      input.value = "";
      update();
      input.focus();
    });

    update();
  }

  document.querySelectorAll<HTMLElement>('[data-tool="word-counter"]').forEach(initWordCounter);
</script>

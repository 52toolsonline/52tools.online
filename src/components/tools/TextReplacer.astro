---
import { Copy, Trash2, Check } from "@lucide/astro";
---

<div class="rounded-[var(--radius-md)] border border-[var(--border-color)] bg-[var(--surface-raised)] p-5 sm:p-6" data-tool="text-replacer">
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="tr-find" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[var(--text-secondary)]">Find</label>
      <input
        id="tr-find"
        type="text"
        data-find
        placeholder="Text to find"
        class="w-full rounded-[var(--radius-sm)] border border-[var(--border-color)] bg-[var(--surface)] px-3 py-2 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--text-primary)]"
      />
    </div>
    <div>
      <label for="tr-replace" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[var(--text-secondary)]">Replace with</label>
      <input
        id="tr-replace"
        type="text"
        data-replace
        placeholder="Replacement text"
        class="w-full rounded-[var(--radius-sm)] border border-[var(--border-color)] bg-[var(--surface)] px-3 py-2 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--text-primary)]"
      />
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
    <label class="flex items-center gap-2 text-sm text-[var(--text-primary)]">
      <input type="checkbox" data-case-sensitive class="h-4 w-4 rounded border-[var(--border-color)]" />
      Case-sensitive
    </label>
    <label class="flex items-center gap-2 text-sm text-[var(--text-primary)]">
      <input type="checkbox" data-whole-word class="h-4 w-4 rounded border-[var(--border-color)]" />
      Whole word
    </label>
    <label class="flex items-center gap-2 text-sm text-[var(--text-primary)]">
      <input type="checkbox" data-use-regex class="h-4 w-4 rounded border-[var(--border-color)]" />
      Regex
    </label>
    <span data-match-count class="ml-auto font-mono text-xs text-[var(--text-secondary)]">0 matches</span>
  </div>

  <div class="mt-4">
    <label for="tr-input" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[var(--text-secondary)]">Input</label>
    <textarea
      id="tr-input"
      data-input
      rows="8"
      placeholder="Paste your text here..."
      class="w-full resize-y rounded-[var(--radius-sm)] border border-[var(--border-color)] bg-[var(--surface)] p-3 font-mono text-sm text-[var(--text-primary)] outline-none focus:border-[var(--text-primary)]"
    ></textarea>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    <button type="button" data-replace-all class="rounded-[var(--radius-sm)] bg-[var(--text-primary)] px-4 py-2 text-sm font-medium text-[var(--surface)] hover:opacity-90">
      Replace all
    </button>
    <button type="button" data-copy class="inline-flex items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--border-color)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--surface)]">
      <Copy class="h-4 w-4" data-copy-icon aria-hidden="true" />
      <Check class="hidden h-4 w-4" data-check-icon aria-hidden="true" />
      <span data-copy-label>Copy</span>
    </button>
    <button type="button" data-clear class="inline-flex items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--border-color)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--surface)]">
      <Trash2 class="h-4 w-4" aria-hidden="true" />
      Clear
    </button>
  </div>

  <div class="mt-4">
    <label for="tr-output" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[var(--text-secondary)]">Output</label>
    <textarea
      id="tr-output"
      data-output
      rows="8"
      readonly
      placeholder="Your result will appear here."
      class="w-full resize-y rounded-[var(--radius-sm)] border border-[var(--border-color)] bg-[var(--surface)] p-3 font-mono text-sm text-[var(--text-primary)] outline-none"
    ></textarea>
  </div>

  <p data-error class="mt-2 hidden text-sm text-red-600 dark:text-red-400"></p>
</div>

<script>
  function escapeRegExp(str: string): string {
    return str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function initTextReplacer(root: HTMLElement) {
    const findInput = root.querySelector<HTMLInputElement>("[data-find]")!;
    const replaceInput = root.querySelector<HTMLInputElement>("[data-replace]")!;
    const caseSensitive = root.querySelector<HTMLInputElement>("[data-case-sensitive]")!;
    const wholeWord = root.querySelector<HTMLInputElement>("[data-whole-word]")!;
    const useRegex = root.querySelector<HTMLInputElement>("[data-use-regex]")!;
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]")!;
    const output = root.querySelector<HTMLTextAreaElement>("[data-output]")!;
    const matchCount = root.querySelector<HTMLElement>("[data-match-count]")!;
    const errorEl = root.querySelector<HTMLElement>("[data-error]")!;
    const replaceAllBtn = root.querySelector<HTMLButtonElement>("[data-replace-all]")!;
    const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy]")!;
    const clearBtn = root.querySelector<HTMLButtonElement>("[data-clear]")!;
    const copyIcon = root.querySelector<HTMLElement>("[data-copy-icon]")!;
    const checkIcon = root.querySelector<HTMLElement>("[data-check-icon]")!;
    const copyLabel = root.querySelector<HTMLElement>("[data-copy-label]")!;

    function buildPattern(): RegExp | null {
      const find = findInput.value;
      if (!find) return null;

      let source = useRegex.checked ? find : escapeRegExp(find);
      if (wholeWord.checked) source = `\\b${source}\\b`;

      const flags = "g" + (caseSensitive.checked ? "" : "i");
      try {
        errorEl.classList.add("hidden");
        return new RegExp(source, flags);
      } catch {
        errorEl.textContent = "Invalid regular expression.";
        errorEl.classList.remove("hidden");
        return null;
      }
    }

    function updateMatchCount() {
      const pattern = buildPattern();
      if (!pattern || !input.value) {
        matchCount.textContent = "0 matches";
        return;
      }
      const matches = input.value.match(pattern);
      matchCount.textContent = `${matches ? matches.length : 0} match${matches?.length === 1 ? "" : "es"}`;
    }

    function doReplace() {
      const pattern = buildPattern();
      if (!pattern) {
        output.value = input.value;
        return;
      }
      output.value = input.value.replace(pattern, replaceInput.value);
    }

    replaceAllBtn.addEventListener("click", doReplace);
    [findInput, replaceInput, caseSensitive, wholeWord, useRegex, input].forEach((el) =>
      el.addEventListener("input", updateMatchCount)
    );

    clearBtn.addEventListener("click", () => {
      input.value = "";
      output.value = "";
      updateMatchCount();
      input.focus();
    });

    copyBtn.addEventListener("click", async () => {
      if (!output.value) return;
      await navigator.clipboard.writeText(output.value);
      copyIcon.classList.add("hidden");
      checkIcon.classList.remove("hidden");
      copyLabel.textContent = "Copied";
      setTimeout(() => {
        copyIcon.classList.remove("hidden");
        checkIcon.classList.add("hidden");
        copyLabel.textContent = "Copy";
      }, 1500);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tool="text-replacer"]').forEach(initTextReplacer);
</script>

---
import Logo from "./Logo.astro";
import { categories } from "../data/categories";

const year = new Date().getFullYear();

const resourceLinks = [
  { href: "/tools", label: "All Tools" },
  { href: "/categories", label: "Categories" },
  { href: "/about", label: "About" },
];
---

<footer class="border-t border-[var(--border-color)]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <Logo variant="lockup" width={120} />
        <p class="mt-4 max-w-xs text-sm text-[var(--text-secondary)]">
          A precise, fast collection of tools for creators, developers, and problem solvers.
        </p>
      </div>

      <div>
        <h2 class="font-mono text-xs uppercase tracking-wide text-[var(--text-secondary)]">Categories</h2>
        <ul class="mt-3 space-y-2">
          {
            categories.slice(0, 6).map((category) => (
              <li>
                <a
                  href={`/categories/${category.slug}`}
                  class="text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                >
                  {category.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-mono text-xs uppercase tracking-wide text-[var(--text-secondary)]">Resources</h2>
        <ul class="mt-3 space-y-2">
          {
            resourceLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-[var(--border-color)] pt-6 text-xs text-[var(--text-secondary)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} 52 Tools. All rights reserved.</p>
      <p>Precision. Utility. Intelligence. Speed. Simplicity. Technology.</p>
    </div>
  </div>
</footer>

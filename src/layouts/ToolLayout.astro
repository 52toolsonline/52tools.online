---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ToolGrid from "../components/ToolGrid.astro";
import type { Tool } from "../data/tools";
import { getCategoryBySlug } from "../data/categories";
import { getRelatedTools } from "../data/tools";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const category = getCategoryBySlug(tool.category);
const related = getRelatedTools(tool);
---

<BaseLayout
  title={tool.name}
  description={tool.description}
  path={`/tools/${tool.slug}`}
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb
      items={[
        { label: "Tools", href: "/tools" },
        ...(category ? [{ label: category.name, href: `/categories/${category.slug}` }] : []),
        { label: tool.name },
      ]}
    />

    <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl">
          {tool.name}
          {
            tool.status === "soon" && (
              <span class="ml-3 align-middle rounded-full border border-[var(--border-color)] px-2 py-0.5 font-mono text-xs uppercase tracking-wide text-[var(--text-secondary)]">
                Coming soon
              </span>
            )
          }
        </h1>
        <p class="mt-2 max-w-2xl text-base text-[var(--text-secondary)]">{tool.description}</p>
      </div>
    </div>

    <div class="mb-16">
      <slot />
    </div>

    {
      related.length > 0 && (
        <section>
          <h2 class="mb-4 font-display text-xl font-semibold text-[var(--text-primary)]">Related tools</h2>
          <ToolGrid tools={related} />
        </section>
      )
    }
  </div>
</BaseLayout>
